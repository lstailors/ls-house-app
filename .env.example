# Vercel preview / app backend
NODE_ENV=development

# ERPNext (single source of truth)
ERPNEXT_BASE_URL=https://erp.lstailors.com
ERPNEXT_API_KEY=replace-with-service-account-api-key
ERPNEXT_API_SECRET=replace-with-service-account-api-secret
# Optional alternative if using an ERPNext session instead of API key/secret.
ERPNEXT_SESSION_TOKEN=

# Internal MCP auth. Prefer MCP_SHARED_SECRET for new deployments.
MCP_SHARED_SECRET=replace-with-random-shared-secret
# Legacy alias still supported by the code.
LST_MCP_SECRET=

# Internal app URL used by sidecar/local MCP clients.
LST_BACKEND_URL=https://app.lstailors.com
BACKEND_URL=

# Existing app/backend secrets
JWT_SECRET=replace-with-jwt-secret
LST_SERVICE_TOKEN=replace-with-internal-service-token
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_MSG_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_MOBILE=+10000000000
SQUARE_ACCESS_TOKEN=replace-with-square-access-token
SQUARE_LOCATION_ID=replace-with-square-location-id
AI_GATEWAY_API_KEY=replace-with-ai-gateway-api-key
N8N_API_KEY=replace-with-n8n-api-key
MAESTRO_WEBHOOK_BASE=https://your-n8n.example.com
MAESTRO_WEBHOOK_SECRET=replace-with-webhook-secret
