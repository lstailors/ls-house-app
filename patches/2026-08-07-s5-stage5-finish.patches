-        headers: { 'Content-Type': 'application/json' },
-        body: JSON.stringify({ ticket_name: ticket.name }),
-      })
-      const result = await res.json().catch(() => ({}))
-      if (!result.ok) throw new Error(result.error ?? 'Print failed')
