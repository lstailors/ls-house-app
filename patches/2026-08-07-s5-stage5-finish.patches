+        <GlassCard className="p-4 space-y-3 border-signal-amber/40">
+          <div className="text-[11px] uppercase tracking-widest text-cream-dim flex items-center gap-1.5">
+            <Clock className="h-3 w-3" /> Reschedule failed delivery
+          </div>
