diff --git a/webapp/src/lib/altsLinks.ts b/webapp/src/lib/altsLinks.ts
new file mode 100644
index 0000000..2cd9b6f
--- /dev/null
+++ b/webapp/src/lib/altsLinks.ts
@@ -0,0 +1,20 @@
+/**
+ * Deep-links into the alts app — the single writer for alteration tickets
+ * and LSH Delivery (create / status / POD all live there). Admin keeps
+ * read-only views and bounces every mutation surface to these URLs.
+ */
+export const ALTS_URL =
+  (import.meta.env.VITE_ALTS_PUBLIC_URL as string | undefined)?.replace(/\/$/, "") ||
+  "https://alts.lstailors.com";
+
+export function altsDeliveriesUrl(id?: string) {
+  return id ? `${ALTS_URL}/deliveries/${encodeURIComponent(id)}` : `${ALTS_URL}/deliveries`;
+}
+
+export function altsTicketUrl(ticketName: string) {
+  return `${ALTS_URL}/orders/alterations/${encodeURIComponent(ticketName)}`;
+}
+
+export function altsPath(path: string) {
+  return `${ALTS_URL}${path.startsWith("/") ? path : `/${path}`}`;
+}
