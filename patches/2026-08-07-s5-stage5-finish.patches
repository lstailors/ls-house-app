From 0b2de38732f96d5e19430ea50d92bc0eaecf79fc Mon Sep 17 00:00:00 2001
From: Sandbox user <tools@notanumber.com>
Date: Fri, 7 Aug 2026 16:08:40 +0000
Subject: [PATCH 4/4] feat(alts): thin reschedule for failed deliveries + Stage
 6 cutover doc
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- DeliveryDetail: failed deliveries get a Reschedule action — pick a new
  datetime, PATCHes status back to 'scheduled' with the new time, delivery
  reappears on the active board. Closes the PodCapture 'Marked failed —
  reschedule' dead end (toast copy updated to match).
- docs/ops/STAGE6_CUTOVER.md: documents (does NOT execute) the permanent
  vercel.json 301s for the locked-down ticket routes, the ERP
  LSH Print Settings.app_base_url flip (existing script), and the auth
  localStorage dual-write cleanup note.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 apps/alts/src/pages/DeliveryDetail.tsx | 53 ++++++++++++++++++++++
 apps/alts/src/pages/PodCapture.tsx     |  2 +-
 docs/ops/STAGE6_CUTOVER.md             | 63 ++++++++++++++++++++++++++
 3 files changed, 117 insertions(+), 1 deletion(-)
 create mode 100644 docs/ops/STAGE6_CUTOVER.md

diff --git a/apps/alts/src/pages/DeliveryDetail.tsx b/apps/alts/src/pages/DeliveryDetail.tsx
index 103322c..72f8d13 100644
--- a/apps/alts/src/pages/DeliveryDetail.tsx
+++ b/apps/alts/src/pages/DeliveryDetail.tsx
@@ -42,6 +42,8 @@ export default function DeliveryDetail() {
   const update = useUpdateDelivery();
 
   const [markDeliveredOpen, setMarkDeliveredOpen] = useState(false);
+  const [rescheduleOpen, setRescheduleOpen] = useState(false);
+  const [rescheduleAt, setRescheduleAt] = useState("");
   const [messageDialogOpen, setMessageDialogOpen] = useState(false);
   const [editingContact, setEditingContact] = useState(false);
   const [contactSearch, setContactSearch] = useState("");
@@ -109,6 +111,22 @@ export default function DeliveryDetail() {
     } catch { toast.error("Could not update"); }
   };
 
+  const handleReschedule = async () => {
+    if (!rescheduleAt) { toast.error("Pick a new date and time"); return; }
+    try {
+      await update.mutateAsync({
+        id: id!,
+        status: "scheduled",
+        scheduledAt: new Date(rescheduleAt).toISOString(),
+      });
+      qc.invalidateQueries({ queryKey: ["delivery", id] });
+      qc.invalidateQueries({ queryKey: ["deliveries"] });
+      setRescheduleOpen(false);
+      setRescheduleAt("");
+      toast.success("Delivery rescheduled — back on the board");
+    } catch { toast.error("Could not reschedule"); }
+  };
+
   const handleCancel = async () => {
     try {
       await update.mutateAsync({ id: id!, status: "cancelled" });
@@ -134,6 +152,7 @@ export default function DeliveryDetail() {
   const isOut = delivery.status === "out_for_delivery";
   const isDelivered = delivery.status === "delivered";
   const isCancelled = delivery.status === "cancelled";
+  const isFailed = delivery.status === "failed";
   const isScheduled = delivery.status === "scheduled";
   const isPickup = (delivery as any).method === "Pickup";
   const canMarkReadyForPickup = isPickup && isScheduled;
@@ -212,6 +231,11 @@ export default function DeliveryDetail() {
             <CheckCircle2 className="h-4 w-4 mr-1.5" /> Mark delivered
           </Button>
         ) : null}
+        {isFailed ? (
