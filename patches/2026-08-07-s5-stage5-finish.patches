From 379d5555638d8260ed6b9f70e44806092bee8ccc Mon Sep 17 00:00:00 2001
From: Sandbox user <tools@notanumber.com>
Date: Fri, 7 Aug 2026 16:05:10 +0000
Subject: [PATCH 2/4] =?UTF-8?q?feat(alts):=20offline=20intake=20queue=20ob?=
 =?UTF-8?q?servability=20=E2=80=94=20badge,=20inspector,=20explicit=20conf?=
 =?UTF-8?q?irm?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Staff can now see and manage tickets queued offline:

- offlineQueue.ts: change events (same-tab CustomEvent + cross-tab
  storage), subscribeOfflineQueue(), retryOfflineJob(id)
- New OfflineQueueBadge: amber 'N QUEUED' pill (hidden when empty) on
  the HomeTiles header and the intake header; opens an inspector sheet
  listing each queued ticket (label, age, attempts, last error) with
  per-job Retry, confirmed Remove, and Retry-all
- IntakeStepped: Finish while offline now shows an explicit
  'Ticket queued offline' confirmation overlay (both the pre-flight
  offline branch and the network-drop error branch), replacing the
  easy-to-miss toast; draft-preserving behavior unchanged

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 .../alts/src/components/OfflineQueueBadge.tsx | 156 ++++++++++++++++++
 apps/alts/src/lib/offlineQueue.ts             |  45 +++++
 apps/alts/src/pages/HomeTiles.tsx             |   2 +
 apps/alts/src/pages/IntakeStepped.tsx         |  36 +++-
 4 files changed, 237 insertions(+), 2 deletions(-)
 create mode 100644 apps/alts/src/components/OfflineQueueBadge.tsx

diff --git a/apps/alts/src/components/OfflineQueueBadge.tsx b/apps/alts/src/components/OfflineQueueBadge.tsx
new file mode 100644
index 0000000..a2ecc70
--- /dev/null
+++ b/apps/alts/src/components/OfflineQueueBadge.tsx
@@ -0,0 +1,156 @@
+import { useEffect, useState, useCallback } from "react";
+import { CloudOff, RefreshCw, Trash2, X, Loader2 } from "lucide-react";
+import { toast } from "sonner";
+import { cn } from "@ls/design/utils";
+import {
+  listOfflineJobs,
+  subscribeOfflineQueue,
+  flushOfflineQueue,
+  retryOfflineJob,
+  removeOfflineJob,
+  type OfflineTicketJob,
+} from "@alts/lib/offlineQueue";
+
+/**
+ * Offline intake queue observability: an amber pill (hidden when the queue is
+ * empty) that opens an inspector sheet with per-job retry / remove and a
+ * retry-all. Mounted on HomeTiles and the intake header.
+ */
+
+export function useOfflineQueue(): OfflineTicketJob[] {
+  const [jobs, setJobs] = useState<OfflineTicketJob[]>(() => listOfflineJobs());
+  useEffect(() => subscribeOfflineQueue(() => setJobs(listOfflineJobs())), []);
+  return jobs;
+}
+
+function jobAge(createdAt: number): string {
+  const mins = Math.max(0, Math.round((Date.now() - createdAt) / 60_000));
+  if (mins < 1) return "just now";
+  if (mins < 60) return `${mins}m ago`;
+  const hrs = Math.round(mins / 60);
+  if (hrs < 24) return `${hrs}h ago`;
+  return `${Math.round(hrs / 24)}d ago`;
+}
+
+function OfflineQueueSheet({ jobs, onClose }: { jobs: OfflineTicketJob[]; onClose: () => void }) {
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [flushingAll, setFlushingAll] = useState(false);
+
+  const retryOne = useCallback(async (id: string) => {
+    setBusyId(id);
+    const r = await retryOfflineJob(id);
+    setBusyId(null);
+    if (r.ok) toast.success("Ticket sent");
+    else toast.error(`Still failing — ${r.error ?? "unknown error"}`);
+  }, []);
+
+  const retryAll = useCallback(async () => {
+    setFlushingAll(true);
+    const r = await flushOfflineQueue();
+    setFlushingAll(false);
+    if (r.ok > 0) toast.success(`Sent ${r.ok} ticket${r.ok === 1 ? "" : "s"}`);
+    if (r.failed > 0) toast.error(`${r.failed} still failing`);
+    if (r.ok === 0 && r.failed === 0 && r.errors.includes("offline")) {
+      toast.error("Still offline — will auto-send when wifi returns");
+    }
+  }, []);
+
+  const removeOne = useCallback((job: OfflineTicketJob) => {
+    const label = job.clientLabel || job.id;
+    if (!window.confirm(`Remove queued ticket for “${label}”?\n\nIt will NOT be sent — the intake is lost unless re-entered.`)) return;
+    removeOfflineJob(job.id);
+    toast.success("Removed from queue");
+  }, []);
+
+  return (
+    <div className="fixed inset-0 z-[90] flex items-end sm:items-center justify-center" role="dialog" aria-label="Offline ticket queue">
+      <button type="button" aria-label="Close" onClick={onClose} className="absolute inset-0 bg-black/55 backdrop-blur-[2px]" />
+      <div className="relative w-full sm:max-w-lg max-h-[80dvh] overflow-hidden rounded-t-2xl sm:rounded-2xl border border-brass/25 bg-forest-deep shadow-2xl flex flex-col">
+        <div className="flex items-center gap-2.5 px-4 py-3 border-b border-brass/15">
+          <CloudOff size={16} className="text-amber-400 shrink-0" />
+          <div className="min-w-0">
+            <div className="text-cream font-medium text-sm">Queued offline tickets</div>
+            <div className="text-[11px] text-cream-dim">Auto-sends when wifi returns · kept 7 days</div>
+          </div>
+          <div className="flex-1" />
+          <button
+            type="button"
+            onClick={retryAll}
+            disabled={flushingAll || jobs.length === 0}
+            className="flex items-center gap-1.5 rounded-md border border-brass/30 px-2.5 py-1.5 text-[11px] font-semibold text-brass-light hover:bg-brass/10 disabled:opacity-50"
+          >
+            {flushingAll ? <Loader2 size={12} className="animate-spin" /> : <RefreshCw size={12} />}
+            Retry all
+          </button>
+          <button type="button" onClick={onClose} aria-label="Close sheet" className="grid place-items-center w-8 h-8 rounded-md text-cream-dim hover:text-cream hover:bg-white/5">
+            <X size={15} />
+          </button>
+        </div>
+
+        <div className="overflow-y-auto divide-y divide-brass/10">
+          {jobs.length === 0 ? (
+            <div className="px-4 py-8 text-center text-sm text-cream-dim">Queue is empty — everything sent.</div>
+          ) : (
+            jobs.map((job) => (
+              <div key={job.id} className="px-4 py-3 flex items-start gap-3">
+                <div className="min-w-0 flex-1">
+                  <div className="text-sm text-cream font-medium truncate">{job.clientLabel || "Walk-in"}</div>
+                  <div className="text-[11px] text-cream-dim mt-0.5">
+                    Queued {jobAge(job.createdAt)}
+                    {job.attempts > 0 ? ` · ${job.attempts} failed attempt${job.attempts === 1 ? "" : "s"}` : ""}
+                  </div>
+                  {job.lastError ? (
+                    <div className="text-[11px] text-red-400/90 mt-1 break-words">{job.lastError}</div>
+                  ) : null}
+                </div>
+                <button
+                  type="button"
+                  onClick={() => retryOne(job.id)}
+                  disabled={busyId === job.id}
+                  className="flex items-center gap-1 rounded-md border border-brass/30 px-2 py-1.5 text-[11px] font-semibold text-brass-light hover:bg-brass/10 disabled:opacity-50 shrink-0"
+                >
+                  {busyId === job.id ? <Loader2 size={12} className="animate-spin" /> : <RefreshCw size={12} />}
+                  Retry
+                </button>
+                <button
+                  type="button"
+                  onClick={() => removeOne(job)}
+                  aria-label="Remove queued ticket"
+                  className="grid place-items-center w-8 h-8 rounded-md border border-red-500/25 text-red-400/80 hover:bg-red-500/10 shrink-0"
+                >
+                  <Trash2 size={13} />
+                </button>
+              </div>
+            ))
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+export function OfflineQueueBadge({ className }: { className?: string }) {
+  const jobs = useOfflineQueue();
+  const [open, setOpen] = useState(false);
+
+  if (jobs.length === 0 && !open) return null;
+
+  return (
+    <>
+      <button
+        type="button"
+        onClick={() => setOpen(true)}
+        className={cn(
+          "flex items-center gap-1.5 rounded-full border border-amber-400/45 bg-amber-400/10 px-2.5 py-1.5",
+          "text-[10.5px] font-bold tracking-[0.06em] text-amber-300 hover:bg-amber-400/20 shrink-0",
+          className,
+        )}
+        title="Tickets queued offline — tap to inspect"
+      >
+        <CloudOff size={12} />
+        {jobs.length} QUEUED
+      </button>
+      {open ? <OfflineQueueSheet jobs={jobs} onClose={() => setOpen(false)} /> : null}
+    </>
+  );
+}
diff --git a/apps/alts/src/lib/offlineQueue.ts b/apps/alts/src/lib/offlineQueue.ts
index cd80e73..5513de6 100644
--- a/apps/alts/src/lib/offlineQueue.ts
+++ b/apps/alts/src/lib/offlineQueue.ts
@@ -37,12 +37,37 @@ function readFile(): QueueFile {
   }
 }
 
+/** Fired on every queue mutation so badges/sheets can re-render in-tab. */
+export const ALTS_OFFLINE_QUEUE_EVENT = "alts-offline-queue-changed";
+
+function notifyChanged() {
+  try {
+    window.dispatchEvent(new CustomEvent(ALTS_OFFLINE_QUEUE_EVENT));
+  } catch {
+    /* SSR / non-DOM */
+  }
+}
+
 function writeFile(f: QueueFile) {
   try {
     localStorage.setItem(ALTS_OFFLINE_QUEUE_KEY, JSON.stringify(f));
   } catch {
     /* quota */
   }
+  notifyChanged();
+}
+
+/** Subscribe to queue changes (same-tab writes + cross-tab storage events). */
+export function subscribeOfflineQueue(cb: () => void): () => void {
+  const onStorage = (e: StorageEvent) => {
+    if (e.key === null || e.key === ALTS_OFFLINE_QUEUE_KEY) cb();
+  };
+  window.addEventListener(ALTS_OFFLINE_QUEUE_EVENT, cb);
+  window.addEventListener("storage", onStorage);
+  return () => {
+    window.removeEventListener(ALTS_OFFLINE_QUEUE_EVENT, cb);
+    window.removeEventListener("storage", onStorage);
+  };
 }
 
 export function listOfflineJobs(): OfflineTicketJob[] {
@@ -125,6 +150,26 @@ export async function flushOfflineQueue(): Promise<FlushResult> {
   }
 }
 
+/** Retry a single queued job now. Removes it on success, bumps attempts on failure. */
+export async function retryOfflineJob(id: string): Promise<{ ok: boolean; error?: string }> {
+  const f = readFile();
+  const job = f.jobs.find((j) => j.id === id);
+  if (!job) return { ok: false, error: "Job no longer queued" };
+  try {
+    await api.post("/api/intake-alterations/tickets", job.body);
+    removeOfflineJob(id);
+    return { ok: true };
+  } catch (e) {
+    const msg = (e instanceof Error ? e.message : String(e)).slice(0, 200);
+    const g = readFile();
+    g.jobs = g.jobs.map((j) =>
+      j.id === id ? { ...j, attempts: (j.attempts || 0) + 1, lastError: msg } : j,
+    );
+    writeFile(g);
+    return { ok: false, error: msg };
+  }
+}
+
 /** Wire once at app root — flushes on online + periodic tick. */
 export function startOfflineQueueWatcher(
   onResult?: (r: FlushResult) => void,
