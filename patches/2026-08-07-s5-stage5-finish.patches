diff --git a/webapp/src/pages/AltsRedirect.tsx b/webapp/src/pages/AltsRedirect.tsx
new file mode 100644
index 0000000..80d6ba4
--- /dev/null
+++ b/webapp/src/pages/AltsRedirect.tsx
@@ -0,0 +1,31 @@
+import { useEffect } from "react";
+import { useLocation, useParams } from "react-router-dom";
+import { altsPath } from "@/lib/altsLinks";
+
+/**
+ * Write-ownership lock-down: alteration ticket intake and mutation live in
+ * alts only. Admin routes that used to host those flows permanently bounce
+ * to the alts equivalent (same pattern as AltsGarmentRedirect / HER-55).
+ *
+ * With no `to` prop the current pathname is preserved — alts mirrors the
+ * /orders/alterations/* route shape. Pass `to` to remap (e.g. /admin/board
+ * → /board). `:ticketName` in `to` is filled from route params.
+ */
+export default function AltsRedirect({ to }: { to?: string }) {
+  const location = useLocation();
+  const params = useParams<{ ticketName?: string }>();
+
+  useEffect(() => {
+    let dest = to ?? location.pathname;
+    if (params.ticketName) {
+      dest = dest.replace(":ticketName", encodeURIComponent(params.ticketName));
+    }
+    window.location.replace(altsPath(dest));
+  }, [to, location.pathname, params.ticketName]);
+
+  return (
+    <div className="flex items-center justify-center min-h-[40vh] text-sm text-cream-muted">
+      Opening in Alts…
+    </div>
+  );
+}
