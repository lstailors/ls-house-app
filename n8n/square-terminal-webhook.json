      ]
    },
    "If Completed": {
      "main": [
        [{ "node": "Fetch Original Log Row", "type": "main", "index": 0 }],
        []
      ]
    },
    "Fetch Original Log Row": {
      "main": [
        [{ "node": "Record Payment in ERPNext", "type": "main", "index": 0 }]
      ]
    }
  },
