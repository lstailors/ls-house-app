{
  "framework": null,
  "installCommand": "bun install && cd backend && bun install && cd ../webapp && bun install",
  "buildCommand": "cd webapp && bun run build",
  "outputDirectory": "webapp/dist",
  "redirects": [
    {
      "source": "/g/:ticket/:garmentId",
      "destination": "https://alts.lstailors.com/g/:ticket/:garmentId",
      "permanent": false
    },
    {
      "source": "/garments/:ticket/:garmentId",
      "destination": "https://alts.lstailors.com/g/:ticket/:garmentId",
      "permanent": false
    },
    {
      "source": "/t/:ticket",
      "destination": "https://alts.lstailors.com/t/:ticket",
      "permanent": false
    },
    {
      "source": "/e-ticket/:ticket",
      "destination": "https://alts.lstailors.com/t/:ticket",
      "permanent": false
    },
    {
      "source": "https://www.my.lstailors.com/:path*",
      "destination": "https://my.lstailors.com/:path*",
      "permanent": true
    },
    {
      "source": "/account",
      "destination": "/login?portal=customer",
      "permanent": false
    },
    {
      "source": "/account/:path*",
      "destination": "/login?portal=customer",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "destination": "/api/[...path]"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/unifi/sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/comms/daily-brief/trigger",
      "schedule": "0 23 * * 1-6"
    },
    {
      "path": "/api/dashboard/floor-brief/trigger",
      "schedule": "0 13 * * 1-6"
    },
    {
      "path": "/api/dashboard/floor-brief/trigger",
      "schedule": "0 16 * * 1-6"
    },
    {
      "path": "/api/dashboard/floor-brief/trigger",
      "schedule": "0 19 * * 1-6"
    },
    {
      "path": "/api/dashboard/floor-brief/trigger",
      "schedule": "0 22 * * 1-6"
    },
    {
      "path": "/api/sofia/briefing/trigger",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/sofia/briefing/trigger",
      "schedule": "0 19 * * 1-5"
    }
  ]
}