{
  "framework": null,
  "installCommand": "bun install && cd webapp && bun install",
  "buildCommand": "cd webapp && bun run build",
  "outputDirectory": "webapp/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/unifi/sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/maestro/brief/trigger",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/maestro/brief/trigger",
      "schedule": "0 16 * * 1-5"
    },
    {
      "path": "/api/maestro/brief/trigger",
      "schedule": "0 19 * * 1-5"
    },
    {
      "path": "/api/sofia/briefing/trigger",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/sofia/briefing/trigger",
      "schedule": "0 16 * * 1-5"
    },
    {
      "path": "/api/sofia/briefing/trigger",
      "schedule": "0 19 * * 1-5"
    }
  ]
}
