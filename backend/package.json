{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "studio": "cloud-studio --port 3001 --hostname 0.0.0.0",
    "verify:erpnext-main": "bun run src/scripts/verify-erpnext-main-doctypes.ts",
    "verify:erpnext-fields": "bun run src/scripts/verify-erpnext-main-fields.ts",
    "verify:production": "bun run src/scripts/verify-production-config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.126",
    "@anthropic-ai/sdk": "^0.100.1",
    "@hono/node-server": "1.12.0",
    "@hono/zod-validator": "^0.8.0",
    "@supabase/supabase-js": "^2.106.2",
    "ai": "^6.0.198",
    "hono": "4.6.0",
    "zod": "4.1.11"
  },
  "optionalDependencies": {
    "@vibecodeapp/backend-sdk": "^1.0.1",
    "@vibecodeapp/cloud-studio": "^0.2.4",
    "@vibecodeapp/proxy": "^2.0.3"
  }
}
