# Server
PORT=3000
NODE_ENV=development

# Supabase (still required on main — hybrid ERPNext + Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Webapp (set in Vercel for frontend build):
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ERPNext
ERPNEXT_BASE_URL=https://your-erpnext.example.com
ERPNEXT_API_KEY=your-api-key
ERPNEXT_API_SECRET=your-api-secret

# JWT (custom auth)
JWT_SECRET=your-jwt-secret

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_MSG_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_MOBILE=+16319260917

# Vercel AI Gateway
# Get your key at: https://vercel.com/docs/ai/vercel-ai-sdk
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

# MCP (shared secret between backend and Claude MCP client)
LST_MCP_SECRET=your-mcp-secret

# Internal service token (for backend→backend calendar calls)
LST_SERVICE_TOKEN=your-service-token

# n8n
N8N_API_KEY=your-n8n-api-key
MAESTRO_WEBHOOK_BASE=https://your-n8n.example.com
MAESTRO_WEBHOOK_SECRET=your-webhook-secret
