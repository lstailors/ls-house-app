# Server
PORT=3000
NODE_ENV=development

# ERPNext (single source of truth)
ERPNEXT_BASE_URL=https://erp.lstailors.com
ERPNEXT_API_KEY=your-api-key
ERPNEXT_API_SECRET=your-api-secret
ERPNEXT_MCP_URL=https://erp-mcp.lstailors.com
ERPNEXT_MCP_TOKEN=your-mcp-token

# JWT (custom auth — validated against ERPNext login)
JWT_SECRET=your-jwt-secret

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_MSG_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_MOBILE=+16319260917

# LIVE vs TEST. LIVE hides TEST-prefix operational records and sends SMS to clients.
# TEST routes outbound SMS/email to the allowlist + a log/preview only.
# Default: production → live, otherwise test.
OPS_MODE=test
SMS_ALLOWLIST=+16319260917

# Square (payments)
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id

# Vercel AI Gateway
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

# MCP (shared secret between backend and Claude MCP client)
LST_MCP_SECRET=your-mcp-secret

# Internal service token (for backend→backend calendar calls)
LST_SERVICE_TOKEN=your-service-token

# n8n
N8N_API_KEY=your-n8n-api-key
MAESTRO_WEBHOOK_BASE=https://your-n8n.example.com
MAESTRO_WEBHOOK_SECRET=your-webhook-secret

# DocuSeal (MTM QC signatures). If unset, staff sign on the phone pad.
# Admin can also save the key from Alts Settings (stored in ERPNext).
DOCUSEAL_URL=https://docuseal.lstailors.com
DOCUSEAL_API_KEY=
DOCUSEAL_TEMPLATE_ID=
DOCUSEAL_WEBHOOK_SECRET=
