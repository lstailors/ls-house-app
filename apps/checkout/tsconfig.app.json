{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@checkout/*": ["./src/*"],
      "@ls/api-client": ["../../packages/api-client/src/index.ts"],
      "@ls/design": ["../../packages/design/src/index.ts"],
      "@ls/design/*": ["../../packages/design/src/*"]
    }
  },
  "include": ["src"]
}
