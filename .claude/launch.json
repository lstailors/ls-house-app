{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--hot", "src/index.ts"],
      "cwd": "backend",
      "port": 3030
    },
    {
      "name": "webapp",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "webapp",
      "port": 8000,
      "autoPort": true
    },
    {
      "name": "booking",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "8100"],
      "cwd": "booking",
      "port": 8100
    }
  ]
}
